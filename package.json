{
  "name": "ai-studio-angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 3000 --host 0.0.0.0",
    "dev": "ng serve --port 3000 --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "audit:index": "npx tsx scripts/refactor-audit-index.mjs",
    "audit:math": "npx tsx scripts/math-compressor-audit.mjs",
    "sim:debug": "npx tsx scripts/refactor-audit-index.mjs && npx tsx scripts/math-compressor-audit.mjs && npx tsx scripts/deep-sim-debug.mjs && npx tsx scripts/ui-sim-debug.mjs",
    "serve:ssr:applet": "node dist/applet/server/server.mjs",
    "lint": "eslint .",
    "postinstall": "cp -f ./node_modules/.bin/plw /usr/local/bin/plw 2>/dev/null || true",
    "plw": "./node_modules/.bin/plw",
    "hott": "./node_modules/.bin/plw"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "@google/genai": "^1.27.0",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "express": "^5.1.0",
    "motion": "^12.23.24",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.0"
  }
}
